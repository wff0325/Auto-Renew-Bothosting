# ============================================================
#  本地配置模板：复制为 .env 后填写。.env 已被 Git 忽略，勿提交。
# ============================================================

# ---------- bot-hosting.net ----------
# 登录邮箱 / 密码（必填）
BOT_HOSTING_EMAIL=
BOT_HOSTING_PASSWORD=

# ---------- gaming4free.net ----------
# 服务器 slug，逗号分隔（必填）。例：fun
G4F_SLUG=
# 剩余小时低于该值才投票（默认 40）
G4F_THRESHOLD=40
# 单次运行最多投几票（默认 3）
G4F_MAX_VOTES=3
# 投票者名字（可选）
G4F_VOTER_NAME=renew-bot
# 走付费通道的金额(cents)，不配则投票。例：750
G4F_DONATE_CENTS=

# ---------- 通知 ----------
# Telegram Bot Token / Chat ID（可选）
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---------- 代理（可选）----------
# 是否使用代理（workflow 的 sing-box 步骤会自动写入）
IS_PROXY=false
PROXY_SERVER=http://127.0.0.1:1081
